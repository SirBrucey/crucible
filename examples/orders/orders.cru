// The `orders` example fleet: an HTTP API, a broker, a database, and an
// inventory consumer, with a durability scenario that posts three orders and
// asserts all three persist.

fleet "orders" {
  deployment: docker;

  service api {
    kinds: [http],
    image: "crucible-example/orders-api:0.1",
    port: 8080,
    env: [
      "DATABASE_URL=mysql://root@db:3306/orders",
      "BROKER_URL=amqp://broker:5672",
      "RUST_LOG=info"
    ],
    healthcheck: ["CMD", "curl", "-fsS", "http://127.0.0.1:8080/healthz"]
  };

  service broker {
    kinds: [amqp],
    image: "rabbitmq:3.13-management",
    port: 5672,
    // Probe the AMQP port rather than run `rabbitmq-diagnostics`. That command
    // starts an Erlang node, and Docker runs healthchecks as the image's default
    // user (root here), so under a slow concurrent boot a probe can create a
    // root-owned /var/lib/rabbitmq/.erlang.cookie before the broker (running as
    // rabbitmq) writes its own; the broker then cannot read the cookie and dies
    // with `.erlang.cookie: eacces`. A bare TCP connect touches no cookie and
    // still gates on the listener.
    healthcheck: ["CMD", "bash", "-c", ": < /dev/tcp/127.0.0.1/5672"]
  };

  service db {
    kinds: [mariadb],
    image: "mariadb:11.4",
    port: 3306,
    env: [
      "MARIADB_ALLOW_EMPTY_ROOT_PASSWORD=yes",
      "MARIADB_DATABASE=orders"
    ],
    healthcheck: ["CMD", "mariadb-admin", "ping", "-h", "127.0.0.1"]
  };

  service inventory {
    kinds: [amqp],
    image: "crucible-example/orders-inventory:0.1",
    port: 8081,
    env: [
      "DATABASE_URL=mysql://root@db:3306/orders",
      "BROKER_URL=amqp://broker:5672",
      "RUST_LOG=info"
    ],
    healthcheck: ["CMD", "curl", "-fsS", "http://127.0.0.1:8081/healthz"]
  };
}

scenario "orders_durability" {
  consistent_within: 15s;

  do { http POST api "/orders" body { item: "book", quantity: 4 } };
  do { http POST api "/orders" body { item: "noodles", quantity: 10 } };
  do { http POST api "/orders" body { item: "usb-c cable", quantity: 1 } };

  expect {
    db.orders.count == 3;
  }
}
